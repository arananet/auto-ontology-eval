    {
      "id": "net_sales_semantics",
      "description": "Both marts have a column named net_sales with different meanings.",
      "involves": [
        {
          "source": "A",
          "table": "fact_sales",
          "column": "net_sales"
        },
        {
          "source": "B",
          "table": "shipments",
          "column": "net_sales"
        }
